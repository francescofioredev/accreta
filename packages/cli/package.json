{
  "name": "accreta",
  "version": "0.1.4",
  "type": "module",
  "license": "MIT",
  "description": "A knowledge base an agent writes and maintains, with provenance to the sources and drift detection when they change.",
  "homepage": "https://github.com/francescofioredev/accreta#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/francescofioredev/accreta.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/francescofioredev/accreta/issues",
  "engines": {
    "node": "^22.16.0 || >=24",
    "bun": ">=1.4.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "accreta": "./dist/bin.js"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@accreta/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "scripts",
    "templates",
    "skills"
  ],
  "dependencies": {
    "@accreta/adapters": "0.1.4",
    "@accreta/core": "0.1.4",
    "@accreta/mcp-server": "0.1.4"
  },
  "scripts": {
    "build": "bun ../../scripts/build-package.ts",
    "prepack": "bun ../../scripts/build-package.ts && bun run ./scripts/copy-assets.ts",
    "postpack": "bun ../../scripts/build-package.ts --clean && bun run ./scripts/copy-assets.ts --clean"
  }
}
