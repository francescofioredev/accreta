{
  "name": "accreta",
  "version": "0.1.1",
  "type": "module",
  "license": "MIT",
  "description": "A knowledge base an agent writes and maintains, with provenance to the sources and drift detection when they change.",
  "homepage": "https://github.com/francescofioredev/accreta#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/francescofioredev/accreta.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/francescofioredev/accreta/issues",
  "engines": {
    "bun": ">=1.3.13"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "accreta": "./src/main.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "scripts",
    "templates",
    "skills"
  ],
  "dependencies": {
    "@accreta/core": "0.1.1",
    "@accreta/adapter-fs": "0.1.1",
    "@accreta/adapter-git": "0.1.1"
  },
  "scripts": {
    "prepack": "bun run ./scripts/copy-assets.ts",
    "postpack": "bun run ./scripts/copy-assets.ts --clean"
  }
}
