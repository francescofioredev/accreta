{
  "name": "@accreta/core",
  "version": "0.1.4",
  "type": "module",
  "license": "MIT",
  "description": "Parsing, link graph, indexing and search. Knows nothing about where sources come from.",
  "homepage": "https://github.com/francescofioredev/accreta#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/francescofioredev/accreta.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/francescofioredev/accreta/issues",
  "engines": {
    "node": "^22.16.0 || >=24",
    "bun": ">=1.4.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@accreta/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "@accreta/source": "./src/runtime.ts",
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "yaml": "^2.7.0"
  },
  "scripts": {
    "build": "bun ../../scripts/build-package.ts",
    "prepack": "bun ../../scripts/build-package.ts",
    "postpack": "bun ../../scripts/build-package.ts --clean"
  }
}
