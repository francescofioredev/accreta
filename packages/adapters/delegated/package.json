{
  "name": "@accreta/adapter-delegated",
  "version": "0.1.4",
  "type": "module",
  "license": "MIT",
  "description": "A source only the agent can reach: accreta declares it, the connector reads it.",
  "homepage": "https://github.com/francescofioredev/accreta#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/francescofioredev/accreta.git",
    "directory": "packages/adapters/delegated"
  },
  "bugs": "https://github.com/francescofioredev/accreta/issues",
  "engines": {
    "node": "^22.16.0 || >=24",
    "bun": ">=1.4.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@accreta/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@accreta/core": "0.1.4"
  },
  "scripts": {
    "build": "bun ../../../scripts/build-package.ts",
    "prepack": "bun ../../../scripts/build-package.ts",
    "postpack": "bun ../../../scripts/build-package.ts --clean"
  }
}
