# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
*.tsbuildinfo

# The index is a derived artifact: it is rebuilt from the knowledge base in
# ~150ms. Committing it would put a binary blob in every diff and would go
# stale the moment anyone edits a page.
*.sqlite
*.sqlite-shm
*.sqlite-wal
.accreta-index*

# Secrets. This repository is public and its history cannot be retracted:
# prevention is the only control that works here.
.env
.env.*
!.env.example
*.pem
*.key
secrets.yaml

# Copied into the CLI package by `prepack` so it ships its own templates, and
# removed again by `postpack`. Committing them would create a second copy that
# drifts from the originals at the repository root with nothing reporting it.
/packages/cli/templates/
/packages/cli/skills/

# Editors / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Test and coverage
coverage/
.nyc_output/

# Logs
*.log
npm-debug.log*
bun-debug.log*

# Local agent scratch space: session notes and working files that are not
# project artifacts. Anything worth keeping graduates to docs/ or an issue.
.scratch/
